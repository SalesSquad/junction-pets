{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:chibi:meta:resume-command:v1",
  "title": "Meta Resume command v1",
  "description": "Bounded synthetic/public transport contract. Valid JSON never grants host authority. Rust gateway and durable transport are separate future work. Revision is capped to JavaScript exact integer range at this boundary.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "taskId",
    "commandId",
    "expectedRevision",
    "operation",
    "payload"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "taskId": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "not": {
        "const": "00000000-0000-0000-0000-000000000000"
      }
    },
    "commandId": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "not": {
        "const": "00000000-0000-0000-0000-000000000000"
      }
    },
    "expectedRevision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "operation": {
      "enum": [
        "confirmStep",
        "interrupt",
        "observe",
        "resume",
        "correctStep",
        "revokeEvidence"
      ]
    },
    "payload": {
      "type": "object"
    }
  },
  "oneOf": [
    {
      "properties": {
        "operation": {
          "const": "confirmStep"
        },
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "stepId"
          ],
          "properties": {
            "stepId": {
              "type": "string",
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
              "not": {
                "const": "00000000-0000-0000-0000-000000000000"
              }
            }
          }
        }
      }
    },
    {
      "properties": {
        "operation": {
          "const": "interrupt"
        },
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "required": [],
          "properties": {}
        }
      }
    },
    {
      "properties": {
        "operation": {
          "const": "observe"
        },
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "evidenceId"
          ],
          "properties": {
            "evidenceId": {
              "type": "string",
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
              "not": {
                "const": "00000000-0000-0000-0000-000000000000"
              }
            }
          }
        }
      }
    },
    {
      "properties": {
        "operation": {
          "const": "resume"
        },
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "evidenceIds"
          ],
          "properties": {
            "evidenceIds": {
              "type": "array",
              "maxItems": 128,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
                "not": {
                  "const": "00000000-0000-0000-0000-000000000000"
                }
              }
            }
          }
        }
      }
    },
    {
      "properties": {
        "operation": {
          "const": "correctStep"
        },
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "stepId"
          ],
          "properties": {
            "stepId": {
              "type": "string",
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
              "not": {
                "const": "00000000-0000-0000-0000-000000000000"
              }
            }
          }
        }
      }
    },
    {
      "properties": {
        "operation": {
          "const": "revokeEvidence"
        },
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "evidenceId"
          ],
          "properties": {
            "evidenceId": {
              "type": "string",
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
              "not": {
                "const": "00000000-0000-0000-0000-000000000000"
              }
            }
          }
        }
      }
    }
  ]
}
