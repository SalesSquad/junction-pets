# Copy to .env.local (gitignored). The relay reads these; the browser never sees them.
# Prefer loading from the macOS Keychain at launch instead of writing values to disk:
#   EXA_API_KEY="$(security find-generic-password -s salesquad.junction2026.exa -w)" \
#   TYPESAFE_API_KEY="$(security find-generic-password -s salesquad.junction2026.typesafe -w)" npm run dev
EXA_API_KEY=
TYPESAFE_API_KEY=
TYPESAFE_MODEL=jev-1.14.0
RELAY_PORT=8787
