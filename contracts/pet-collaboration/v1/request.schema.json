{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chibi.pet/contracts/pet-collaboration/v1/request.schema.json",
  "title": "PetCollaborationRequest v1",
  "description": "Untrusted request metadata only. The host must resolve authorityRef and verify policy; JSON Schema is not authorization.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "kind",
    "requestId",
    "conversationId",
    "tenantId",
    "actorPetId",
    "recipientPetId",
    "capabilityId",
    "sourceSha",
    "authorityRef",
    "requestedEffect",
    "createdAt",
    "expiresAt",
    "depth",
    "context",
    "budget"
  ],
  "properties": {
    "schemaVersion": {
      "const": "pet-collaboration.v1"
    },
    "kind": {
      "const": "request"
    },
    "requestId": {
      "$ref": "#/$defs/id"
    },
    "conversationId": {
      "$ref": "#/$defs/id"
    },
    "parentRequestId": {
      "$ref": "#/$defs/id"
    },
    "tenantId": {
      "$ref": "#/$defs/id"
    },
    "actorPetId": {
      "$ref": "#/$defs/id"
    },
    "recipientPetId": {
      "$ref": "#/$defs/id"
    },
    "capabilityId": {
      "$ref": "#/$defs/id"
    },
    "authorityRef": {
      "$ref": "#/$defs/id"
    },
    "sourceSha": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}$"
    },
    "requestedEffect": {
      "enum": [
        "read",
        "proposal",
        "write"
      ]
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "expiresAt": {
      "type": "string",
      "format": "date-time"
    },
    "depth": {
      "type": "integer",
      "minimum": 0,
      "maximum": 8
    },
    "context": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ref",
        "digest",
        "dataClass"
      ],
      "properties": {
        "ref": {
          "$ref": "#/$defs/id"
        },
        "digest": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "dataClass": {
          "enum": [
            "synthetic",
            "public",
            "tenant-private"
          ]
        }
      }
    },
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "maxTokens",
        "maxDepth"
      ],
      "properties": {
        "maxTokens": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000000
        },
        "maxDepth": {
          "type": "integer",
          "minimum": 0,
          "maximum": 8
        }
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_:./-]*$"
    }
  }
}
