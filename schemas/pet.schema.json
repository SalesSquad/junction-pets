{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://chibi.pet/schemas/junction-pet-v1.json",
  "type": "object", "additionalProperties": false,
  "required": ["schemaVersion","id","slug","version","agentName","displayName","company","tagline","introduction","welcome","accent","artIndex","capabilities","starterPrompts","sources","sourceEvidence","availability"],
  "properties": {
    "schemaVersion": {"const": 1},
    "id": {"type":"string","pattern":"^junction\\.[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "slug": {"type":"string","pattern":"^junction-[a-z0-9]+(?:-[a-z0-9]+)*$","maxLength":96},
    "version": {"type":"string","pattern":"^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "agentName": {"type":"string","minLength":1,"maxLength":12},
    "displayName": {"type":"string","minLength":3,"maxLength":100},
    "company": {
      "type":"object","additionalProperties":false,"required":["name","slug","role","website"],
      "properties":{"name":{"type":"string","minLength":2,"maxLength":100},"slug":{"type":"string","pattern":"^[a-z0-9]+(?:-[a-z0-9]+)*$"},"role":{"enum":["challenge","technology","main","collaborator"]},"website":{"type":"string","pattern":"^https://"}}
    },
    "tagline":{"type":"string","minLength":10,"maxLength":160},
    "introduction":{"type":"string","minLength":30,"maxLength":1200},
    "welcome":{"type":"string","minLength":20,"maxLength":700},
    "accent":{"type":"string","pattern":"^#[0-9a-fA-F]{6}$"},
    "artIndex":{"type":"integer","minimum":0,"maximum":33},
    "capabilities":{"type":"array","minItems":2,"maxItems":8,"items":{"type":"object","additionalProperties":false,"required":["id","title","description","kind","inputs","outputs","requiresConnection"],"properties":{"id":{"type":"string","pattern":"^[a-z0-9]+(?:-[a-z0-9]+)*$"},"title":{"type":"string","minLength":3,"maxLength":100},"description":{"type":"string","minLength":20,"maxLength":1500},"kind":{"enum":["guidance","analysis","planning","connection-required"]},"inputs":{"type":"array","minItems":1,"items":{"type":"string","minLength":1}},"outputs":{"type":"array","minItems":1,"items":{"type":"string","minLength":1}},"requiresConnection":{"type":"boolean"}}}},
    "starterPrompts":{"type":"array","minItems":3,"maxItems":6,"uniqueItems":true,"items":{"type":"string","minLength":12,"maxLength":600}},
    "sources":{"type":"array","minItems":1,"maxItems":12,"items":{"type":"object","additionalProperties":false,"required":["id","title","url","publisher","checkedAt","summary"],"properties":{"id":{"type":"string","pattern":"^[a-z0-9]+(?:-[a-z0-9]+)*$"},"title":{"type":"string","minLength":3},"url":{"type":"string","pattern":"^https://"},"publisher":{"type":"string","minLength":2},"checkedAt":{"type":"string","pattern":"^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},"summary":{"type":"string","minLength":20,"maxLength":2000}}}},
    "sourceEvidence":{"type":"object","additionalProperties":false,"required":["roster","roleVerified","notes"],"properties":{"roster":{"type":"string","minLength":10},"roleVerified":{"type":"boolean"},"notes":{"type":"string","minLength":10}}},
    "availability":{"type":"object","additionalProperties":false,"required":["content","runtime","companyEndorsed"],"properties":{"content":{"enum":["ready","needs-review"]},"runtime":{"const":"chibi-host-required"},"companyEndorsed":{"const":false}}}
  }
}
