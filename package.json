{
  "name": "@chibi/junction-pets",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": ["apps/catalog"],
  "engines": {"node": ">=22"},
  "scripts": {
    "validate": "node scripts/validate.mjs",
    "test": "node --test tests/*.test.mjs",
    "catalog": "node scripts/build-catalog.mjs",
    "dev": "npm run dev --workspace @chibi/junction-catalog --",
    "build": "npm run catalog && npm run build --workspace @chibi/junction-catalog",
    "prepare:import": "node scripts/prepare-import.mjs",
    "check:host": "node scripts/check-host.mjs"
  },
  "dependencies": {"ajv": "8.20.0"},
  "devDependencies": {"qrcode": "1.5.4", "jsqr": "1.4.0", "pngjs": "7.0.0"}
}
