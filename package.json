{
  "name": "@chibi/junction-pets",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/catalog"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "validate": "node scripts/validate.mjs",
    "test": "node --test",
    "test:wave2": "node --test contracts/pet-collaboration/v1/*.test.mjs services/*/*.test.mjs apps/mission-control/*.test.mjs",
    "test:mission-control": "node --test apps/mission-control/*.test.mjs",
    "test:page-embed": "node apps/mission-control/page-embed-smoke.mjs",
    "test:browser": "node tests/browser-smoke.mjs",
    "catalog": "node scripts/build-catalog.mjs",
    "dev": "npm run dev --workspace @chibi/junction-catalog --",
    "build": "npm run catalog && npm run build --workspace @chibi/junction-catalog",
    "prepare:import": "node scripts/prepare-import.mjs",
    "check:host": "node scripts/check-host.mjs",
    "ops:status": "node scripts/ops-build-status.mjs",
    "ops:work": "node scripts/ops-work.mjs",
    "ops:cloud:plan": "node scripts/ops-cloud-dispatch.mjs",
    "ops:developers": "node scripts/ops-developer-roster.mjs",
    "ops:preview": "npm run ops:status && node scripts/build-internal-preview.mjs && npm run demo:council",
    "ops:page:build": "npm run ops:status && node scripts/build-owner-page-preview.mjs",
    "demo:council": "node scripts/pet-collaboration-demo.mjs",
    "eval:prepare": "node scripts/behavior-eval.mjs prepare",
    "eval:check": "node scripts/behavior-eval.mjs check",
    "plugins:generate": "node scripts/build-pet-plugins.mjs",
    "plugins:check": "node scripts/build-pet-plugins.mjs --check",
    "verify:source": "npm run plugins:check && npm run validate && npm test && npm run build && npm run ops:status && node scripts/ops-development-progress.mjs --check && git diff --check"
  },
  "dependencies": {
    "ajv": "8.20.0"
  },
  "devDependencies": {
    "jsqr": "1.4.0",
    "playwright": "1.65.0",
    "pngjs": "7.0.0",
    "qrcode": "1.5.4"
  }
}
